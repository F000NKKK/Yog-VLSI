  "screen.alu.empty": "Put programmed chips in the slots below",
  "screen.alu.bus": {"value": "Bus {side}", "comment": "A bus node's title in the ALU graph (a side a digital cable reaches)"},
  "screen.alu.help": {
    "value": "Inputs (left): what each side's cable brings in. Outputs (right): what goes out into it.\nDrag from an output pin (right edge) to an input pin (left edge) to wire them — chip to chip stays inside the ALU.\nDrag a wire off its input pin to move it, or into empty space to remove it. Drag a chip, or the In and Out panels, by its title.\nDrag empty space to move the view; the wheel zooms it.\nA side a Digital Cable reaches is a bus: wire into a channel's left pin to drive it, out of its right pin to read it; pull the bar at its bottom down for more channels.\nName a Redstone Port (right-click it) and its name shows on the side its cable reaches.",
    "comment": "Tooltip of the (i) in the ALU screen"
  },
  "screen.port.redstone_title": "Redstone Port"
