{
  "mod_name": {"value": "Yog VLSI", "comment": "The mod's name (yog.toml name)"},
  "mod_description": {"value": "Very Large Scale Integration — design and fabricate redstone microchips with a Rust-accelerated simulation VM. Multi-tier workbench, ALU block, and chip-to-chip linking.", "comment": "yog.toml description"},
  "item_group": {"value": "Yog VLSI", "key": "itemGroup.yog-vlsi", "comment": "Creative tab"},
  "block.vlsi_workbench": "VLSI Workbench",
  "block.vlsi_workbench.desc": "§7Design and fabricate redstone microchips.\n§7Right-click to open the design interface.\n§7Insert blank chips, Blueprints, or resources.",
  "block.alu_wood": "Wood ALU",
  "block.alu_wood.desc": "§7Insert programmed microchips. Right-click to open the node editor.\n§7Max chips: 2 | Digital channels/side: 8",
  "block.alu_stone": "Stone ALU",
  "block.alu_stone.desc": "§7Insert programmed microchips. Right-click to open the node editor.\n§7Max chips: 3 | Digital channels/side: 16",
  "block.alu_gold": "Gold ALU",
  "block.alu_gold.desc": "§7Insert programmed microchips. Right-click to open the node editor.\n§7Max chips: 4 | Digital channels/side: 24",
  "block.alu_iron": "Iron ALU",
  "block.alu_iron.desc": "§7Insert programmed microchips. Right-click to open the node editor.\n§7Max chips: 5 | Digital channels/side: 32",
  "block.alu_diamond": "Diamond ALU",
  "block.alu_diamond.desc": "§7Insert programmed microchips. Right-click to open the node editor.\n§7Max chips: 6 | Digital channels/side: 48",
  "block.alu_netherite": "Netherite ALU",
  "block.alu_netherite.desc": "§7Insert programmed microchips. Right-click to open the node editor.\n§7Max chips: 8 | Digital channels/side: 64",
  "block.analog_cable": "Analog Cable",
  "block.analog_cable.desc": "§7Carries a single analog redstone signal (0–15).\n§7Connects Redstone Port to external redstone.",
  "block.digital_cable": "Digital Cable",
  "block.digital_cable.desc": "§7Carries up to 256 digital bits (64 channels × 4 colors).\n§7Connects Digital Ports between ALUs.",
  "block.redstone_port": "Redstone Port",
  "block.redstone_port.desc": "§7Adapter between ALU and external redstone.\n§7Place on any side of an ALU. Connect Analog Cable on one side, redstone on the other.",
  "block.port_input": "VLSI Port (Input)",
  "block.port_output": "VLSI Port (Output)",
  "block.port_bidi": "VLSI Port (Bidirectional)",
  "block.port.desc": {"value": "§7Place inside a chip's virtual circuit.\n§7Right-click to cycle Input/Output/Bidirectional.\n§7Sneak + right-click, then type a name in chat to rename.", "comment": "Tooltip shared by the three VLSI port blocks"},
  "item.chip_wood": "Wooden Microchip",
  "item.chip_wood.desc": "§7Tier: §eWood§7 | §b5 ticks/s§7 | §a16×16 world\n§7Place in a §6VLSI Workbench§7 to design circuits.\n§7Ports: none (unprogrammed)",
