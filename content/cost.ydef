// What crafting a block takes, down to the six resources (resource.ydef):
// what a design's blocks cost to fabricate. Anything not here costs a
// cobblestone; `*` in an id is any run of letters.
{
 "kind": "table",
 "id": "cost",
 "columns": {
  "of": "[string]",
  "takes": "{string: f64}"
 },
 "rows": {
  "planks": {
   "of": [
    "minecraft:*_planks"
   ],
   "takes": {
    "minecraft:oak_log": 0.25
   }
  },
