<?xml version="1.0" encoding="utf-8"?>
<!-- How an assembly recipe (content/recipes/assembly.ydef) is laid out:
     the workbench's <RecipeArea kind="assembly">, and books. -->
<Component name="AssemblyLayout" recipe_layout="assembly" width="104" height="36">
    <RecipeSlot slot="parts" x="1" y="1" frame="true" />
    <RecipeSlot slot="parts" x="19" y="1" frame="true" />
    <RecipeSlot slot="parts" x="37" y="1" frame="true" />
    <RecipeSlot slot="parts" x="1" y="19" frame="true" />
    <RecipeSlot slot="parts" x="19" y="19" frame="true" />
    <RecipeSlot slot="parts" x="37" y="19" frame="true" />
    <Image source="sprite:arrow" w="24" h="17" x="58" y="10" />
    <RecipeResult x="87" y="10" />
    <RecipeCount x="89" y="28" />
</Component>
