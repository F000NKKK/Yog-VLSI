<?xml version="1.0" encoding="utf-8"?>
<!-- An ALU's inventory screen: its node graph, its chip slots and the
     player's inventory. View model: AluVm in alu.rs; the graph is the
     GraphSurface there. -->
<Screen id="yog-vlsi:alu"
        width="400"
        height="262"
        anchor="center"
        theme="minecraft:vanilla"
        x:ViewModel="AluVm">
    <Screen.Resources>
        <Style x:Key="Info"
               target="Label"
               w="11"
               h="11"
               align="center"
               text="i"
               color="#FFFFFF"
               bg="#FF4A70B0"
               shadow="false"
               no_wrap="true" />
    </Screen.Resources>
    <Grid w="100%" h="100%" rows="14,*,Auto" padding="4 8 8 8">
        <Row gap="4" align="center">
            <Label flex="1" text="{x:Bind title()}" no_wrap="true" ellipsis="true" />
            <Label x:Name="help" style="@Info" tooltip="@Strings.screen.alu.help" />
            <Button x:Name="clear"
                    w="96"
                    h="14"
                    text="@Strings.screen.alu.clear_links"
                    enabled="{x:Bind has_wires()}"
                    command="{x:Bind clear()}" />
        </Row>
        <Surface x:Name="graph" Grid.Row="1" w="100%" h="100%" source="yog-vlsi:alu_graph" />
        <Row Grid.Row="2" margin="4 0 0 0" gap="12">
            <Column gap="2">
                <Label text="@Strings.screen.alu.chips" no_wrap="true" />
                <Row gap="0">
                    <Slot index="0" accepts="yog-vlsi:chip_wood yog-vlsi:chip_stone yog-vlsi:chip_iron yog-vlsi:chip_gold yog-vlsi:chip_diamond yog-vlsi:chip_netherite" />
                    <Slot index="1" accepts="yog-vlsi:chip_wood yog-vlsi:chip_stone yog-vlsi:chip_iron yog-vlsi:chip_gold yog-vlsi:chip_diamond yog-vlsi:chip_netherite" />
                    <Slot index="2" accepts="yog-vlsi:chip_wood yog-vlsi:chip_stone yog-vlsi:chip_iron yog-vlsi:chip_gold yog-vlsi:chip_diamond yog-vlsi:chip_netherite" />
                    <Slot index="3" accepts="yog-vlsi:chip_wood yog-vlsi:chip_stone yog-vlsi:chip_iron yog-vlsi:chip_gold yog-vlsi:chip_diamond yog-vlsi:chip_netherite" />
                </Row>
                <Row gap="0">
                    <Slot index="4" accepts="yog-vlsi:chip_wood yog-vlsi:chip_stone yog-vlsi:chip_iron yog-vlsi:chip_gold yog-vlsi:chip_diamond yog-vlsi:chip_netherite" />
                    <Slot index="5" accepts="yog-vlsi:chip_wood yog-vlsi:chip_stone yog-vlsi:chip_iron yog-vlsi:chip_gold yog-vlsi:chip_diamond yog-vlsi:chip_netherite" />
                    <Slot index="6" accepts="yog-vlsi:chip_wood yog-vlsi:chip_stone yog-vlsi:chip_iron yog-vlsi:chip_gold yog-vlsi:chip_diamond yog-vlsi:chip_netherite" />
                    <Slot index="7" accepts="yog-vlsi:chip_wood yog-vlsi:chip_stone yog-vlsi:chip_iron yog-vlsi:chip_gold yog-vlsi:chip_diamond yog-vlsi:chip_netherite" />
                </Row>
                <Label text="{x:Bind slots_text()}" w="72" font_scale="0.7" color="#FF404040" shadow="false" />
            </Column>
            <PlayerInventory />
        </Row>
    </Grid>
</Screen>
