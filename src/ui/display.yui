<?xml version="1.0" encoding="utf-8"?>
<!-- A Display's settings: its size and bus channels. View model: DisplayVm in display.rs. -->
<Screen id="yog-vlsi:display"
        width="200"
        height="96"
        anchor="center"
        theme="minecraft:vanilla"
        x:ViewModel="DisplayVm">
    <Column w="100%" h="100%" padding="6 8 8 8" gap="4">
        <Label text="@Strings.screen.display.title" no_wrap="true" />
        <TextBox x:Name="size"
                 w="100%"
                 h="14"
                 max_length="4"
                 text="{x:Bind size, Mode=TwoWay}"
                 placeholder="@Strings.screen.display.size_placeholder" />
        <TextBox x:Name="channel"
                 w="100%"
                 h="14"
                 max_length="3"
                 text="{x:Bind channel, Mode=TwoWay}"
                 placeholder="@Strings.screen.display.channel_placeholder" />
        <Label text="{x:Bind channels()}" font_scale="0.7" color="#FF404040" shadow="false" />
        <Button x:Name="done" w="60" h="20" halign="right" text="@Strings.screen.port.done" command="{x:Bind done()}" />
    </Column>
</Screen>
