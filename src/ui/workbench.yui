<?xml version="1.0" encoding="utf-8"?>
<!-- The VLSI Workbench's inventory screen. View model: WorkbenchVm in workbench.rs. -->
<Screen id="yog-vlsi:workbench"
        width="276"
        height="222"
        anchor="center"
        theme="minecraft:vanilla"
        x:ViewModel="WorkbenchVm">
    <Screen.Resources>
        <Style x:Key="Header" target="Label" no_wrap="true" />
        <Style x:Key="Count" target="Label" w="22" font_scale="0.7" no_wrap="true" />
        <Style x:Key="Vial" target="Column" w="6" h="18" padding="1" gap="0" bg="sprite:slot" />
        <Style x:Key="Fill" target="Column" w="100%" min_h="0" />
        <Style x:Key="Action" target="Button" w="100%" h="20" />
        <Style x:Key="Info"
               target="Label"
               w="11"
               h="11"
               align="center"
               text="i"
               color="#FFFFFF"
               bg="#FF4A70B0"
               shadow="false"
               no_wrap="true" />
    </Screen.Resources>
    <Grid w="100%" h="100%" rows="16,*,Auto" padding="4 8 8 8">
        <Label style="@Header" text="@res:Strings.screen.workbench.title" />
        <Row Grid.Row="1" gap="8">
            <!-- Chip out, resources in. -->
            <Column w="104" gap="2">
                <Label style="@Header" text="@res:Strings.screen.workbench.chip" />
                <Slot index="0" accepts="yog-vlsi:chip_wood yog-vlsi:chip_stone yog-vlsi:chip_iron yog-vlsi:chip_gold yog-vlsi:chip_diamond yog-vlsi:chip_netherite" />
                <Label style="@Header" text="@res:Strings.screen.workbench.resources" />
                <Row gap="4">
                    <Column gap="2">
                        <Row gap="2" align="center" tooltip="{x:Bind resource_tooltip(Resource::Redstone)}">
                            <Slot index="1" accepts="#yog:dusts/redstone #yog:storage_blocks/redstone" />
                            <Column style="@Vial">
                                <Spacer flex="1" />
                                <Column style="@Fill" h="{x:Bind vial(Resource::Redstone)}" bg="@res:Colors.vial.redstone" />
                            </Column>
                            <Label style="@Count" text="{x:Bind amount(Resource::Redstone)}" />
                        </Row>
                        <Row gap="2" align="center" tooltip="{x:Bind resource_tooltip(Resource::Iron)}">
                            <Slot index="2" accepts="#yog:nuggets/iron #yog:ingots/iron #yog:storage_blocks/iron" />
                            <Column style="@Vial">
                                <Spacer flex="1" />
                                <Column style="@Fill" h="{x:Bind vial(Resource::Iron)}" bg="@res:Colors.vial.iron" />
                            </Column>
                            <Label style="@Count" text="{x:Bind amount(Resource::Iron)}" />
                        </Row>
                        <Row gap="2" align="center" tooltip="{x:Bind resource_tooltip(Resource::Gold)}">
                            <Slot index="3" accepts="#yog:nuggets/gold #yog:ingots/gold #yog:storage_blocks/gold" />
                            <Column style="@Vial">
                                <Spacer flex="1" />
                                <Column style="@Fill" h="{x:Bind vial(Resource::Gold)}" bg="@res:Colors.vial.gold" />
                            </Column>
                            <Label style="@Count" text="{x:Bind amount(Resource::Gold)}" />
                        </Row>
                    </Column>
                    <Column gap="2">
                        <Row gap="2" align="center" tooltip="{x:Bind resource_tooltip(Resource::Quartz)}">
                            <Slot index="4" accepts="#yog:gems/quartz #yog:storage_blocks/quartz" />
                            <Column style="@Vial">
                                <Spacer flex="1" />
                                <Column style="@Fill" h="{x:Bind vial(Resource::Quartz)}" bg="@res:Colors.vial.quartz" />
                            </Column>
                            <Label style="@Count" text="{x:Bind amount(Resource::Quartz)}" />
                        </Row>
                        <Row gap="2" align="center" tooltip="{x:Bind resource_tooltip(Resource::Wood)}">
                            <Slot index="5" accepts="#yog:logs" />
                            <Column style="@Vial">
                                <Spacer flex="1" />
                                <Column style="@Fill" h="{x:Bind vial(Resource::Wood)}" bg="@res:Colors.vial.wood" />
                            </Column>
                            <Label style="@Count" text="{x:Bind amount(Resource::Wood)}" />
                        </Row>
                        <Row gap="2" align="center" tooltip="{x:Bind resource_tooltip(Resource::Stone)}">
                            <Slot index="6" accepts="#yog:cobblestones #yog:stones" />
                            <Column style="@Vial">
                                <Spacer flex="1" />
                                <Column style="@Fill" h="{x:Bind vial(Resource::Stone)}" bg="@res:Colors.vial.cobblestone" />
                            </Column>
                            <Label style="@Count" text="{x:Bind amount(Resource::Stone)}" />
                        </Row>
                    </Column>
                </Row>
            </Column>

            <!-- The blueprint and what's on it. -->
            <Column flex="1" h="100%" gap="2">
                <Row gap="4" align="center">
                    <Label style="@Header" text="@res:Strings.screen.workbench.blueprint" />
                    <Label x:Name="help" style="@Info" tooltip="@res:Strings.screen.workbench.blueprint_help" />
                </Row>
                <Row gap="4" align="center">
                    <Slot index="7" accepts="yog-vlsi:blueprint" />
                    <Label x:Name="no_blueprint"
                           text="@res:Strings.screen.workbench.no_blueprint"
                           color="#FF505050"
                           visible="{x:Bind no_blueprint()}" />
                    <Label x:Name="design_name"
                           flex="1"
                           text="{x:Bind design_name()}"
                           ellipsis="true"
                           visible="{x:Bind has_design()}" />
                </Row>

                <!-- A blank blueprint: name and tier, then Create. -->
                <Column gap="3" visible="{x:Bind blank()}">
                    <TextBox x:Name="name"
                             w="100%"
                             h="14"
                             max_length="32"
                             text="{x:Bind name, Mode=TwoWay}"
                             placeholder="@res:Strings.screen.workbench.name_placeholder" />
                    <Button x:Name="tier" style="@Action" text="{x:Bind tier_text()}" d:text="@res:Strings.tier_wood" command="{x:Bind next_tier()}" />
                    <Button x:Name="template" style="@Action" text="{x:Bind template_text()}" d:text="@res:Strings.screen.workbench.template_empty" command="{x:Bind next_template()}" />
                    <Button x:Name="create"
                            style="@Action"
                            text="@res:Strings.screen.workbench.create"
                            enabled="{x:Bind can_create()}"
                            command="{x:Bind create()}" />
                </Column>

                <!-- A design: what it is and what it costs. -->
                <Column gap="1" visible="{x:Bind has_design()}">
                    <Label x:Name="design_tier" text="{x:Bind design_tier()}" font_scale="0.7" no_wrap="true" />
                    <Label style="@Header" margin="3 0 0 0" text="@res:Strings.screen.workbench.cost" />
                    <ItemsControl x:Name="cost" w="100%" gap="1" items="{x:Bind cost_rows()}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="CostRow">
                                <Label w="100%" text="{x:Bind text}" color="{x:Bind color}" font_scale="0.7" no_wrap="true" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Column>
            </Column>
        </Row>

        <Row Grid.Row="2" margin="4 0 0 0" gap="8">
            <PlayerInventory />
            <Column flex="1" gap="4">
                <Button x:Name="edit"
                        style="@Action"
                        text="@res:Strings.screen.workbench.edit"
                        enabled="{x:Bind has_design()}"
                        command="{x:Bind edit()}" />
                <Button x:Name="fabricate"
                        style="@Action"
                        text="@res:Strings.screen.workbench.fabricate"
                        enabled="{x:Bind can_fabricate()}"
                        command="{x:Bind fabricate()}" />
            </Column>
        </Row>
    </Grid>
</Screen>
